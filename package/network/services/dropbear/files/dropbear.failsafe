#!/bin/sh

_dropbear()
{
	/usr/sbin/dropbear "$@" </dev/null >/dev/null 2>&1
}

_dropbearkey()
{
	/usr/bin/dropbearkey "$@" </dev/null >/dev/null 2>&1
}

_ensurekey()
{
	_dropbearkey -y -f "$1" && return
	rm -f "$1"
	_dropbearkey -f "$@" || {
		rm -f "$1"
		return 1
	}
}

failsafe_dropbear () {
	local kargs kcount ktype tkey

	kargs=
	kcount=0
	for ktype in ed25519 ecdsa ; do
		tkey="/tmp/dropbear_failsafe_${ktype}_host_key"

		_ensurekey "${tkey}" -t "${ktype}" || :
		[ -s "${tkey}" ] || {
			rm -f "${tkey}" "${tkey}.pub"
			continue
		}

		chmod 0400 "${tkey}"
		kargs="${kargs}${kargs:+ }-r ${tkey}"
		kcount=$((kcount+1))
	done

	## use RSA only if none of the modern algorithms is supported
	if [ "${kcount}" = 0 ] ; then
		ktype=rsa
		tkey="/tmp/dropbear_failsafe_${ktype}_host_key"

		_ensurekey "${tkey}" -t "${ktype}" || :
		if [ -s "${tkey}" ] ; then
			chmod 0400 "${tkey}"
			kargs="${kargs}${kargs:+ }-r ${tkey}"
			kcount=$((kcount+1))
		else
			rm -f "${tkey}" "${tkey}.pub"
		fi
	fi

	[ "${kcount}" != 0 ] || {
		echo 'DROPBEAR IS BROKEN' >&2
		return 1
	}

	_dropbear ${kargs}
}

boot_hook_add failsafe failsafe_dropbear
